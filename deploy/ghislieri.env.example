# Non-secret settings. Production: /etc/ghislieri/ghislieri.env. Development: copy to ./.env and
# add GS_BOT_TOKEN=<test bot token> (never the production token: the bot refuses to start with it).
GS_ENV=prod
GS_LOG_LEVEL=INFO
# Telegram user id that receives error alerts
GS_ALERT_CHAT_ID=
GS_SMTP_USER=
# JSON list
GS_MEALS_RECAP_TO=[]
# CUPS destination; empty = default printer
GS_PRINTER=
